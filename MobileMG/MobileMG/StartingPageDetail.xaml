<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileMG.StartingPageDetail"
             Title="Detail">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="baseline_info_24" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>
    <StackLayout>
        <Label Text="O que fazemos?" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" Margin="0, 50, 0, 0" FontSize="24" />
        <Label HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Start" Margin="15" FontSize="18" Text="WS Towers é uma empresa que detém direitos de uso em estádios de todo o país. Exemplos de uso são: partidas de futebol, shows, visitas etc. 
Por ser uma grande empresa a WS Tower também possui responsabilidade socioambiental. Desta forma, a partir desse aplicativo android
que conta com a ajuda das pessoa ao redor do país, para denunciar atentados contra o meio ambiente. "/>
    </StackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileMG.LoginPage">
    <ContentPage.Content>

        <Grid>

            <StackLayout Grid.Row="0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">

                <Label Text="Acessar" HorizontalOptions="Center"/>
                <Entry WidthRequest="300" Placeholder="usuário" x:Name="usuarioInput" Margin="0,20,0,20"/>
                <Entry  Placeholder="senha" x:Name="senhaInput" IsPassword="True"/>

                <Button x:Name="btnEntrar" Text="Login" WidthRequest="120" HorizontalOptions="Center" Clicked="btnEntrar_Clicked"/>

            </StackLayout>
             
            <Label  x:Name="toastNotification" IsEnabled="false" Text="Usuário/Senha inválidos!" FontSize="18" VerticalOptions="End" HorizontalOptions="FillAndExpand" Margin="5,5,5,5" BackgroundColor="#505050" HeightRequest="60" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>

        </Grid>
    </ContentPage.Content>
</ContentPage>
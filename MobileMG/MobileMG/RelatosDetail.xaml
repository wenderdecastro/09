<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileMG.RelatosDetail">
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Margin="25,0" >
                <Label Text="Relato" Margin="0,25" FontSize="20" VerticalOptions="Start" HorizontalOptions="CenterAndExpand" />
                <Image BackgroundColor="Red" HorizontalOptions="FillAndExpand" HeightRequest="200" />
                <Label Text="Relato" HorizontalOptions="Start" Margin="0 ,10" FontSize="18"/>
                <Label x:Name="relatoDescricao" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" />
            </StackLayout>
            <StackLayout  Orientation="Horizontal" Margin="0 ,10">
                <Label x:Name="relatoLatitude"/>
                <Label Text="X" Margin="25, 0"/>
                <Label x:Name="relatoLongitude"/>
            </StackLayout>
            <BoxView HeightRequest="3" HorizontalOptions="Fill" Color="#000000" VerticalOptions="Center"/>
            <StackLayout Margin="25,0" >
                <Label Margin="0,5" x:Name="usuarioNome"/>
                <Label Margin="0,5" x:Name="usuarioTelefone"/>
                <Label Margin="0,5" x:Name="usuarioEmail"/>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App2.App"
             xmlns:components="clr-namespace:App2.Components">
    <Application.Resources>
        <ResourceDictionary>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Montserrat"/>
                <Setter Property="TextColor" Value="#182643"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Montserrat"/>
                <Setter Property="BackgroundColor" Value="#EE761B"/>
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="Montserrat"/>
            </Style>
            

            
            <Color x:Key="Primary">#EE761B</Color>
            <Color x:Key="Secondary">#182643</Color>
            <Color x:Key="Grey">#bababa</Color>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
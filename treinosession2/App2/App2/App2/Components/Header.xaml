      <StackLayout Orientation="Horizontal" BackgroundColor="AliceBlue" >
            <Image x:Name="imagemUsuario" HeightRequest="50" WidthRequest="50" Margin="20" BackgroundColor="Black"/>
            <Label Text="nomeusuario" x:Name="nomeUsuario" VerticalOptions="CenterAndExpand"/>

        </StackLayout>
  </ContentView.Content>
</ContentView>